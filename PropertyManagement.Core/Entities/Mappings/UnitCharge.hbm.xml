<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="PropertyManagement.Core"
                   namespace="PropertyManagement.Core.Entities">
    <class name="UnitCharge" table="UnitsCharges">
        <id name="Id" type="Int64">
            <generator class="identity"/>
        </id>
        <many-to-one name="Unit" column="UnitId" class="PropertyManagement.Core.Entities.Unit, PropertyManagement.Core" />
        <many-to-one name="Expense" column="ExpenseId" class="PropertyManagement.Core.Entities.Expense, PropertyManagement.Core" />
        <many-to-one name="Currency" column="CurrencyId" class="PropertyManagement.Core.Entities.Currency, PropertyManagement.Core" />
        <property name="SumToPay"/>
        <property name="PayedSum"/>
      <bag name="IncomePayments" table="IncomesPayments_PayedExpenses" lazy="true">
        <key>
          <column name="UnitChargeId" />
        </key>
        <many-to-many class="IncomePayment">
          <column name="IncomePaymentId" />
        </many-to-many>
      </bag>
    </class>
</hibernate-mapping>
