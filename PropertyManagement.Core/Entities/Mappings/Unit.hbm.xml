<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="PropertyManagement.Core"
                   namespace="PropertyManagement.Core.Entities">
    <class name="Unit" table="Units">
        <id name="Id" type="Int64">
            <generator class="identity"/>
        </id>
        <property name="Number" />
        <property name="FamilyName" />
        <property name="MembersCount" />
        <property name="PercentIdealParts" />
        <property name="Floor" />
        <property name="IsDeleted" />
        <bag name="NoChargeServices" table="UnitNoChargeService" lazy="true">
          <key>
            <column name="UnitId" />
          </key>
          <many-to-many class="Service">
            <column name="ServiceId" />
          </many-to-many>
        </bag>
        <property name="Balance" />
        <property name="Deactivated" />
    </class>
</hibernate-mapping>
