<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="PropertyManagement.Core"
                   namespace="PropertyManagement.Core.Entities">
    <class name="ResMoney" table="ResMoney">
        <id name="Id" type="Int64">
            <generator class="identity"/>
        </id>
      <many-to-one name="Detection" column="DetectionId" class="PropertyManagement.Core.Entities.Detection, PropertyManagement.Core" />
      <many-to-one name="Unit" column="UnitId" class="PropertyManagement.Core.Entities.Unit, PropertyManagement.Core" />
      <many-to-one name="Currency" column="CurrencyId" class="PropertyManagement.Core.Entities.Currency, PropertyManagement.Core" />
        <property name="PayedSum" />
        <property name="InsertDate" />
    </class>
</hibernate-mapping>
