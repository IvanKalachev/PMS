<?xml version="1.0" encoding="utf-8" ?>
<hibernate-mapping xmlns="urn:nhibernate-mapping-2.2"
                   assembly="PropertyManagement.Core"
                   namespace="PropertyManagement.Core.Entities">
    <class name="Service" table="Services">
        <id name="Id" type="Int64">
            <generator class="identity"/>
        </id>
        <property name="Name" />
        <many-to-one name="ChargeType" column="DefaultChargeTypeId" class="PropertyManagement.Core.Entities.ChargeType, PropertyManagement.Core" />
        <property name="IsCost"/>
        <property name="IsProfit"/>
    </class>
</hibernate-mapping>
