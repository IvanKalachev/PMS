@model List<PropertyManagement.Web.Models.IncomesModel>
@using PropertyManagement.Web.Helpers
@{
    ViewBag.Title = "PrintShortIncomes";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";

}

<h2>@System.Configuration.ConfigurationManager.AppSettings["propertyName"]</h2>

<h2>@ViewBag.Month</h2>

<input type="submit" value="Принтирай" onclick="window.print()" id="print_button" />

<table cellpadding="10px" id="table_incomes_short">
    <tr>
        <td class="bold">
            Ап.№
        </td>
        <td class="bold">
            Собственик
        </td>
        <td class="bold">
            Брой обитатели
        </td>
        <td class="bold">
            % иделани части
        </td>
        <td class="bold">
            Дължима сума за месеца
        </td>
        <td class="bold">
            Задължения от предишни месеци
        </td>
        <td class="bold">
            Внесени плащания за месеца (в брой)
        </td>
        <td class="bold">
            Общо за плащане
        </td>
    </tr>
    @{string cl = "";}
    @for (int i = 0; i < Model.Count; i++)
    {
        if (i % 2 != 0)
        {
            cl = "alterniting";
        }
        else
        {
            cl = "";
        }
            
        <tr class="@cl">
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.Number)
                @Html.HiddenFor(m => m[i].Unit.Id)
            </td>
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.FamilyName)
            </td>
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.MembersCount)
            </td>
            <td height="38">
                @Model[i].Unit.PercentIdealParts %
            </td>
            <td class="bold" height="38">
                <div>
                    @Model[i].SumToPay €
                </div>
                @if (ViewBag.ShowBGNEquivalent)
                {
                    <div>
                        @PMHelper.ConvertToBGN(Model[i].SumToPay)
                    </div>
                }
            </td>
            <td height="38">
               @Model[i].PrevSaldo.ToString("0.00") €
            </td>
            <td height="38">
                @Model[i].PayedSum.ToString("0.00") €
            </td>
            <td class="bold" height="38">
                <div>
                    @Model[i].GrandTotal.ToString("0.00") €
                </div>
                @if (ViewBag.ShowBGNEquivalent)
                {
                    <div>
                        @PMHelper.ConvertToBGN(Model[i].GrandTotal)
                    </div>
                }
            </td>
        </tr>
    }
    <tr class="full_incomes_footer">
        <td>
        </td>
        <td>
        </td>
        <td>
            @Model.Sum(x => x.Unit.MembersCount)
        </td>
        <td>
            @Model.Sum(x => x.Unit.PercentIdealParts) %
        </td>
        <td>
            <div>
                @Model.Sum(x => x.SumToPay).ToString("0.00") €
            </div>
            @if (ViewBag.ShowBGNEquivalent)
            {
                <div>
                    @PMHelper.ConvertToBGN(Model.Sum(x => x.SumToPay))
                </div>
            }
        </td>
        <td>
            @Model.Sum(x => x.PrevSaldo).ToString("0.00") €
        </td>
        <td>
            @Model.Sum(x => x.PayedSum).ToString("0.00") €
        </td>
        <td>
            <div>
                @Model.Sum(x => x.GrandTotal).ToString("0.00") €
            </div>
            @if (ViewBag.ShowBGNEquivalent)
            {
                <div>
                    @PMHelper.ConvertToBGN(Model.Sum(x => x.GrandTotal))
                </div>
            }
        </td>
    </tr>
</table>
@if(ViewBag.ShowBGNEquivalent)
{
    <div style="margin-top: 5px; font-size: 16px">
        Стойностите в лева са посочени единствено за целите на двойно обозначаване по смисъла на Закона за въвеждане на еврото в Република България и са изчислени по официалния курс на БНБ <span style="font-weight: bold">1 EUR = 1,95583 BGN.</span>
    </div>
}

@Html.Partial("_PrintFooter")