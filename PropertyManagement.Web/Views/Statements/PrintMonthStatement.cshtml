@model PropertyManagement.Web.Models.StatementModel
@{
    ViewBag.Title = "Принтиране на месечен отчет - Property Management";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";
}
<input type="submit" value="Принтирай" onclick="window.print()" id="print_button" />
<h2>
    Отчет за месец @PropertyManagement.Web.Helpers.MonthsYears.GetMonth(Model.Detection.Month)
    @Model.Detection.Year г.</h2>
<table width="450px" id="table_unit_charges">
    <tr>
        <td align="center" colspan="3" class="total">
            П Р И Х О Д И
        </td>
    </tr>
    @if (Model.Profits.Count > 0)
    {
        <tr>
            <td colspan="3" align="center" class="total">
                Месечни начисления
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="bold">Услуга</span>
            </td>
            <td>
                <span class="bold">Сума</span>
            </td>
        </tr>
        foreach (var profit in Model.Profits)
        {
        <tr>
            <td colspan="2">
                @profit.Service.Name
            </td>
            <td>
                @profit.Sum лв.
            </td>
        </tr>
        }
    }
    @if (Model.PayedChargesForPreviousDetections.Count > 0)
    {
        <tr>
            <td colspan="3" align="center" class="total">
                Платени стари задължения
            </td>
        </tr>
        <tr>
            <td>
                <span class="bold">Апартамент</span>
            </td>
            <td>
                <span class="bold">Месец</span>
            </td>
            <td>
                <span class="bold">Сума</span>
            </td>
        </tr>
        foreach (var payedCharge in Model.PayedChargesForPreviousDetections)
        {
        <tr>
            <td>
                @payedCharge.Unit.FamilyName ап. @payedCharge.Unit.Number ет. @payedCharge.Unit.Floor
            </td>
            <td>
                @PropertyManagement.Web.Helpers.MonthsYears.GetMonth(payedCharge.Detection.Month)
                @payedCharge.Detection.Year
            </td>
            <td>
                @payedCharge.Sum лв.
            </td>
        </tr>
        }
    }
     @if (Model.NotpayedForDetection.Count > 0)
    {
        <tr>
            <td colspan="3" align="center" class="total">
                Не събрани задължения
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="bold">Апартамент</span>
            </td>
            <td>
                <span class="bold">Сума</span>
            </td>
        </tr>
        foreach (var notPayedCharge in Model.NotpayedForDetection)
        {
        <tr>
            <td colspan="2">
                @notPayedCharge.Unit.FamilyName ап. @notPayedCharge.Unit.Number ет. @notPayedCharge.Unit.Floor
            </td>
            <td>
                @notPayedCharge.Sum лв.
            </td>
        </tr>
        }
        foreach (var notPayedChargeInCurrentDet in Model.NotpayedForDetectionAndPaiedInOtherDet)
        {
            <tr>
                <td colspan="2">
                    @notPayedChargeInCurrentDet.Unit.FamilyName ап. @notPayedChargeInCurrentDet.Unit.Number ет. @notPayedChargeInCurrentDet.Unit.Floor
                </td>
                <td>
                    @notPayedChargeInCurrentDet.Sum лв.
                </td>
            </tr>
        }
    }
    <tr>
        <td colspan="3" align="center" class="total">
            Общо приходи:
            @Html.DisplayFor(m => m.TotalPrihodi) лв.
        </td>
    </tr>
</table>
<br />
<table width="450px" id="table_unit_charges">
    <tr>
        <td align="center" colspan="3" class="total">
            Р А З Х О Д И
        </td>
    </tr>
    @if (Model.Costs.Count > 0)
    {
        <tr>
            <td class="total" colspan="3" align="center">
                Месечни начисления
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <span class="bold">Услуга</span>
            </td>
            <td>
                <span class="bold">Сума</span>
            </td>
        </tr>
        foreach (var profit in Model.Costs)
        {
        <tr>
            <td colspan="2">
                @profit.Service.Name
            </td>
            <td>
                @profit.Sum лв.
            </td>
        </tr>
        }
    }
    @if (Model.ExtraExpensesForDetection.Count > 0)
    {
        <tr>
            <td colspan="2">
                <span class="bold">Услуга</span>
            </td>
            <td>
                <span class="bold">Сума</span>
            </td>
        </tr>
        foreach (var extraExpense in Model.ExtraExpensesForDetection)
        {
        <tr>
            <td colspan="3" align="center" class="total">
                Извънредни разходи
            </td>
        </tr>
        <tr>
            <td colspan="2">
                @extraExpense.Service.Name
            </td>
            <td>
                @extraExpense.Sum лв.
            </td>
        </tr>
        }
    }
    <tr>
        <td colspan="3" align="center" class="total">
            Общо разходи:
            @Html.DisplayFor(m => m.TotalRazhodi) лв.
        </td>
    </tr>
</table>
<br />
<br />
<div class="total">
    Общо приходи: @Html.DisplayFor(m => m.TotalPrihodi) лв.
</div>
<div class="total">
    Общо разходи: @Html.DisplayFor(m => m.TotalRazhodi) лв.
</div>
<div class="total">
    Остатък: @Html.DisplayFor(m => m.RemainingSum) лв.
</div>
@Html.Partial("_PrintFooter")
