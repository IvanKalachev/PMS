@model IList<PropertyManagement.Web.Models.UnitUnpaidChargesModel>
@{
    ViewBag.Title = "Неплатени задължения преглед - Property Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section featured {
    <section class="featured">
        <div class="content-wrapper">
            <hgroup class="title">
                <span class="expenseDistribution">Неплатени задължения - @Model[0].Charges[0].Unit.FamilyName, 
                    @Model[0].Charges[0].Unit.Number, ет. @Model[0].Charges[0].Unit.Floor</span>
            </hgroup>
        </div>
    </section>
}

   @if (Model.Count > 0)
   {
        @Html.Hidden("unitId", Model[0].Charges[0].Unit.Id)
   }
   
   <input type="submit"value="Печат" onclick="openPrintReport()"/>

@Html.Partial("_UnitCharges", Model)

<br />
<br />
@Html.ActionLink("<<< Обратно", "Index", "Home", new { @class="bold" })

@section Scripts {
    <script type="text/javascript">

        function openPrintReport() {
            window.open("PrintUnitCharges?unitId=" + @Model[0].Charges[0].Unit.Id, "_blank", "toolbar=yes, scrollbars=yes, resizable=yes, top=10, left=5, width=648, height=728, toolbar=no, titlebar=no");
        }

    </script>
}