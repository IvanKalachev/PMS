@model List<PropertyManagement.Web.Models.IncomesModel>
@using PropertyManagement.Web.Helpers
@{
    ViewBag.Title = "PrintShortIncomes";
    Layout = "~/Views/Shared/_PrintLayout.cshtml";

}

<h2>@System.Configuration.ConfigurationManager.AppSettings["propertyName"]</h2>

<h2>@ViewBag.Month</h2>

<input type="submit" value="Принтирай" onclick="window.print()" id="print_button" />

<table cellpadding="10px" id="table_incomes_short">
    <tr>
        <td class="bold">
            Ап.№
        </td>
        <td class="bold">
            Собственик
        </td>
        <td class="bold">
            Брой обитатели
        </td>
        <td class="bold">
            % иделани части
        </td>
        <td class="bold">
            Дължима сума за месеца
        </td>
        <td class="bold">
            Задължения от предишни месеци
        </td>
        <td class="bold">
            Внесени плащания за месеца
        </td>
        <td class="bold">
            Общо за плащане
        </td>
    </tr>
    @{string cl = "";}
    @for (int i = 0; i < Model.Count; i++)
    {
        if (i % 2 != 0)
        {
            cl = "alterniting";
        }
        else
        {
            cl = "";
        }
            
        <tr class="@cl">
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.Number)
                @Html.HiddenFor(m => m[i].Unit.Id)
            </td>
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.FamilyName)
            </td>
            <td height="38">
                @Html.DisplayFor(m => m[i].Unit.MembersCount)
            </td>
            <td height="38">
                @Model[i].Unit.PercentIdealParts %
            </td>
            <td class="bold" height="38">
                <div>
                    @Model[i].SumToPay @Model[i].Currency.Symbol
                </div>
                <div>
                    @PMHelper.ConvertCurrency(@Model[i].SumToPay, @Model[i].Currency, @Model[i].SecondaryCurrency)
                </div>
            </td>
            <td height="38">
               <div>
                   @Model[i].PrevSaldo.ToString("0.00") @Model[i].Currency.Symbol
               </div>
               <div>
                   @PMHelper.ConvertCurrency(@Model[i].PrevSaldo, @Model[i].Currency, @Model[i].SecondaryCurrency)
               </div>
            </td>
            <td height="38">
                <div>
                    @Model[i].PayedSum.ToString("0.00") @Model[i].Currency.Symbol
                </div>
                <div>
                   @PMHelper.ConvertCurrency(@Model[i].PayedSum, @Model[i].Currency, @Model[i].SecondaryCurrency)
                </div>
            </td>
            <td class="bold" height="38">
                <div>
                    @Model[i].GrandTotal.ToString("0.00") @Model[i].Currency.Symbol
                </div>
                <div>
                    @PMHelper.ConvertCurrency(@Model[i].GrandTotal, @Model[i].Currency, @Model[i].SecondaryCurrency)
                </div>
            </td>
        </tr>
    }
    <tr class="full_incomes_footer">
        <td>
        </td>
        <td>
        </td>
        <td>
            @Model.Sum(x => x.Unit.MembersCount)
        </td>
        <td>
            @Model.Sum(x => x.Unit.PercentIdealParts) %
        </td>
        <td>
            <div>
                @Model.Sum(x => x.SumToPay).ToString("0.00") @Model.FirstOrDefault().Currency.Symbol
            </div>
            <div>
                @PMHelper.ConvertCurrency(@Model.Sum(x => x.SumToPay), @Model.FirstOrDefault().Currency, @Model.FirstOrDefault().SecondaryCurrency)
            </div>
        </td>
        <td>
            <div>
                @Model.Sum(x => x.PrevSaldo).ToString("0.00") @Model.FirstOrDefault().Currency.Symbol
            </div>
            <div>
                @PMHelper.ConvertCurrency(@Model.Sum(x => x.PrevSaldo), @Model.FirstOrDefault().Currency, @Model.FirstOrDefault().SecondaryCurrency)
            </div>
        </td>
        <td>
            <div>
                @Model.Sum(x => x.PayedSum).ToString("0.00") @Model.FirstOrDefault().Currency.Symbol
            </div>
            <div>
                @PMHelper.ConvertCurrency(@Model.Sum(x => x.PayedSum), @Model.FirstOrDefault().Currency, @Model.FirstOrDefault().SecondaryCurrency)
            </div>
        </td>
        <td>
            <div>
                @Model.Sum(x => x.GrandTotal).ToString("0.00") @Model.FirstOrDefault().Currency.Symbol
            </div>
            <div>
                @PMHelper.ConvertCurrency(@Model.Sum(x => x.GrandTotal), @Model.FirstOrDefault().Currency, @Model.FirstOrDefault().SecondaryCurrency)
            </div>
        </td>
    </tr>
</table>

@Html.Partial("_PrintFooter")