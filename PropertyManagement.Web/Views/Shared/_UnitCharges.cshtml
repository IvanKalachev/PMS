@model IList<PropertyManagement.Web.Models.UnitUnpaidChargesModel>

@foreach (var charge in Model)
{
    <table cellpadding="10px" width="450px" id="table_unit_charges">
        <tr class="unit_unpaid_charge_header">
            <td colspan="3" align="center">
                @PropertyManagement.Web.Helpers.MonthsYears.GetMonth(charge.Detection.Month) @charge.Detection.Year
            </td>
        </tr>
        <tr class="unpaid_unit_charge_header">
            <td width="56%">
                Услуга
            </td>
            <td width="22%">
                Сума
            </td>
            <td width="22%">
                Платено
            </td>
        </tr>
        @foreach (var ch in charge.Charges)
        {
            <tr>
                <td>
                    @ch.Expense.Service.Name
                </td>
                 <td>
                    @ch.SumToPay €
                </td>
                <td>
                    @ch.PayedSum €
                </td>
            </tr>
            
        }
        <tr class="full_incomes_footer">
            <td align="right">
                Общо
            </td>
            <td>
                @charge.ChargesTotal €
            </td>
            <td>
                @charge.PaidTotal €
            </td>
        </tr>
    </table>
    <br />
}
<br />
@{var totalSum = Model.Sum(x => x.Charges.Sum(y => y.SumToPay)); }
@{var payedSum = Model.Sum(x => x.Charges.Sum(y => y.PayedSum)); }
@{var remainTopay = totalSum - payedSum; }

<div class="unpaid_total">
Общо дължима сума: @totalSum €
</div>

<div class="unpaid_total" style="background-color:Green">
Общо платено: @payedSum €
</div>

<div class="unpaid_total" style="background-color:#C00000">
Оставащо за плащане: @remainTopay €
</div>